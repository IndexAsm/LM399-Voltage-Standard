  46:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_i2c_ex.c ****           (++) HAL_I2CEx_DisableFastModePlus()
  47:Drivers/STM32G4xx_HAL_Driver/Src/stm32g4xx_hal_i2c_ex.c ****   @endverbatim
