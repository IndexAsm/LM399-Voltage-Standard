 146:Core/Src/main.c ****   /* Infinite loop */
 147:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 148:Core/Src/main.c ****     while (1)
 149:Core/Src/main.c ****     {
 150:Core/Src/main.c ****         if (!heater_state) {
 151:Core/Src/main.c ****             if (HAL_GetTick() - time_setup_start > HEATUP_TIME) {
 152:Core/Src/main.c ****                 heater_state = 1;
