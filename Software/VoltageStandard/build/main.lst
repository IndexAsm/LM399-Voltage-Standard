 112:Core/Src/main.c **** void WriteInitialCalibration(
 113:Core/Src/main.c ****     M24Cxx* eeprom, 
 114:Core/Src/main.c ****     const char* LM399_serial_number, 
 115:Core/Src/main.c ****     const char* initial_cal_date,
 116:Core/Src/main.c ****     const char* initial_cal_voltage,
 117:Core/Src/main.c ****     float initial_cal_temperature
 118:Core/Src/main.c **** ) {
 119:Core/Src/main.c **** 
 120:Core/Src/main.c ****     if (M24Cxx_Read_Byte(eeprom, EEPROM_ADDR_INIT_CAL_DONE))
 121:Core/Src/main.c ****         return;
 122:Core/Src/main.c ****     CalibrationDataInfo calInfo;
 123:Core/Src/main.c ****     calInfo.entry_addr = 0x20 + sizeof(CalibrationDataInfo);
 124:Core/Src/main.c ****     calInfo.entry_size = 0xf;
 125:Core/Src/main.c ****     calInfo.len = 0;
 126:Core/Src/main.c ****     strcpy(calInfo.LM399_serial_number, LM399_serial_number);
 127:Core/Src/main.c ****     strcpy(calInfo.initial_cal_date, initial_cal_date);
 128:Core/Src/main.c ****     strcpy(calInfo.initial_cal_voltage, initial_cal_voltage);
 129:Core/Src/main.c ****     calInfo.initial_cal_temperature = initial_cal_temperature;
 130:Core/Src/main.c ****     M24Cxx_Write_Buffer(eeprom, EEPROM_ADDR_OPERATING_TIME, (uint8_t*)&calInfo, sizeof(CalibrationD
 131:Core/Src/main.c **** 
 132:Core/Src/main.c ****     M24Cxx_Write_Byte(eeprom, EEPROM_ADDR_INIT_CAL_DONE, 1);
 133:Core/Src/main.c **** }
