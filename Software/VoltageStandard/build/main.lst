  90:Core/Src/main.c **** uint16_t ReadHourStats(M24Cxx* eeprom) {
  91:Core/Src/main.c ****     union HourBuffer {
  92:Core/Src/main.c ****         uint8_t b8[2];
  93:Core/Src/main.c ****         uint16_t b16;
  94:Core/Src/main.c ****     }  buffer;
  95:Core/Src/main.c **** 
  96:Core/Src/main.c ****     M24Cxx_Read_Bytes(eeprom, EEPROM_ADDR_OPERATING_TIME, buffer.b8, 2);
  97:Core/Src/main.c ****     return buffer.b16;
  98:Core/Src/main.c **** }
  99:Core/Src/main.c **** 
 100:Core/Src/main.c **** void WriteHourStats(M24Cxx* eeprom, uint16_t val) {
 101:Core/Src/main.c ****     union HourBuffer {
