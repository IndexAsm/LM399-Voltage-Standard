 154:Core/Src/main.c ****                 HAL_GPIO_WritePin(LED_G_GPIO_Port, LED_G_Pin, 1);
 155:Core/Src/main.c ****             }
 156:Core/Src/main.c ****         }
 157:Core/Src/main.c **** 
 158:Core/Src/main.c ****         
 159:Core/Src/main.c **** 
 160:Core/Src/main.c **** 
 161:Core/Src/main.c ****         // Get counter value
 162:Core/Src/main.c ****         uint32_t uptime = HAL_GetTick();
 163:Core/Src/main.c ****         if (uptime - uptime_start > 1000) {
 164:Core/Src/main.c ****             uptime_start = uptime;
 165:Core/Src/main.c ****             uptime_s++;
 166:Core/Src/main.c ****             if (uptime_s >= 3600) {
 167:Core/Src/main.c ****                 uptime_s = 0;
 168:Core/Src/main.c ****                 //SaveHourStats();
 169:Core/Src/main.c ****             }
 170:Core/Src/main.c ****             usbTxBufferLen = snprintf((char*)usbTxBuffer, USB_BUFLEN, "Uptime: %us\r\n", uptime_s);
 171:Core/Src/main.c ****             while(CDC_Transmit_FS(usbTxBuffer, usbTxBufferLen) == USBD_BUSY) {}
 172:Core/Src/main.c **** 
 173:Core/Src/main.c **** 
 174:Core/Src/main.c ****             float temp = TMP102_GetReading(&hi2c1);
 175:Core/Src/main.c ****             uint32_t integer_part = (int)temp;                             // 12
 176:Core/Src/main.c ****             uint32_t fractional_part = (int)((temp - integer_part) * 100);
 177:Core/Src/main.c ****             usbTxBufferLen = snprintf((char*)usbTxBuffer, USB_BUFLEN, "Temperature: %u.%u°C\r\n", 
 178:Core/Src/main.c ****             while(CDC_Transmit_FS(usbTxBuffer, usbTxBufferLen) == USBD_BUSY) {}
 179:Core/Src/main.c **** 
 180:Core/Src/main.c ****             uint8_t byte_res = M24Cxx_Read_Byte(&eeprom, 0x0);
 181:Core/Src/main.c **** 
 182:Core/Src/main.c ****             usbTxBufferLen = snprintf((char*)usbTxBuffer, USB_BUFLEN, "EEPROM: %u\r\n", (uint16_t) 
 183:Core/Src/main.c ****             while(CDC_Transmit_FS(usbTxBuffer, usbTxBufferLen) == USBD_BUSY) {}
 184:Core/Src/main.c ****         }
 185:Core/Src/main.c **** 
